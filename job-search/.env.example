# Where the SQLite database lives (default: data/jobsearch.db)
JOBSEARCH_DB_PATH=data/jobsearch.db

# Freshness defaults (days)
FIRST_SYNC_DAYS=7
MAX_JOB_AGE_DAYS=21
ARCHIVE_AFTER_DAYS=14

# Needed from step 3 (AI scoring / tailoring)
ANTHROPIC_API_KEY=

# Needed from step 2 (job ingestion)
SERPAPI_KEY=
# Free tier is 100 searches/month; each run uses at most this many
SERPAPI_QUERIES_PER_RUN=3
SERPAPI_MONTHLY_LIMIT=100
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Path to the Google OAuth client file (Desktop app, Gmail API read-only)
GMAIL_CREDENTIALS_FILE=credentials.json

# Needed for the daily digest email (step 6)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=
